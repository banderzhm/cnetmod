+            close_sent_ = true;
+        }
+        if (!send_buf_.empty())
+        {
+            const auto written = co_await async_write_all(
+                reinterpret_cast<const char*>(send_buf_.data()), send_buf_.size());
+            send_buf_.clear();
+            if (!written)
+            {
+                connected_ = false;
+                co_return std::unexpected(written.error());
+            }
+        }
+        if (failure || received_close)
+        {
+            connected_ = false;
+            if (failure)
+                co_return std::unexpected(failure);
+            co_return {};
+        }
+        if (!need_read && recv_buf_.readable_bytes())
+            continue;
+#if defined(CNETMOD_HAS_IO_URING) && defined(CNETMOD_HAS_IO_URING_BUFFER_RING) && defined(IORING_RECV_MULTISHOT)
+        if (receiver && cancel_token_)
+        {
+            (void)co_await receiver->async_stop();
+            receiver.reset();
+        }
+        if (receiver)
+        {
+            auto block = co_await receiver->async_next();
+            if (!block)
+            {
+                const auto error = block.error();
+                if (error == std::errc::no_buffer_space || error == std::errc::invalid_argument ||
+                    error == std::errc::operation_not_supported)
+                {
+                    (void)co_await receiver->async_stop();
+                    receiver.reset();
+                    continue;
+                }
+                connected_ = false;
+                co_return std::unexpected(error);
+            }
+            if (block->size() == 0)
+            {
+                connected_ = false;
+                co_return std::unexpected(make_error_code(errc::connection_reset));
+            }
+            const auto data = block->data();
+            const auto writable = recv_buf_.prepare(data.size);
+            std::copy_n(static_cast<const std::byte*>(data.data), data.size,
+                static_cast<std::byte*>(writable.data));
+            recv_buf_.commit(data.size);
+            continue;
+        }
+#endif
+        auto writable = recv_buf_.prepare(4096);
+        const auto read = co_await async_read_some(static_cast<char*>(writable.data), writable.size);
+        if (!read || *read == 0)
+        {
+            connected_ = false;
+            co_return std::unexpected(read ? make_error_code(errc::connection_reset) : read.error());
+        }
+        recv_buf_.commit(*read);
+    }
+    co_return {};
+#if defined(CNETMOD_HAS_IO_URING) && defined(CNETMOD_HAS_IO_URING_BUFFER_RING) && defined(IORING_RECV_MULTISHOT)
+    };
+    std::expected<void, std::error_code> result;
+    std::exception_ptr exception;
+    try
+    {
+        result = co_await process();
+    }
+    catch (...)
+    {
+        exception = std::current_exception();
+    }
+    if (receiver)
+    {
+        const auto stopped = co_await receiver->async_stop();
+        if (!stopped && result)
+            result = std::unexpected(stopped.error());
+    }
+    if (exception)
+        std::rethrow_exception(exception);
+    co_return result;
+#endif
+}
 
