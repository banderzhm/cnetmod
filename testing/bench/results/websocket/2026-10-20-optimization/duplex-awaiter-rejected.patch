+/// Full-duplex exchange with caller-owned buffers and no helper coroutine.
+/// The entire output and one receive retire before the awaiting coroutine resumes.
+/// Keep the socket, buffers and this immovable operation alive until completion.
+export class io_uring_exchange
+{
+public:
+    io_uring_exchange(io_uring_context& context, socket& stream,
+        const_buffer output, mutable_buffer input) noexcept;
+    io_uring_exchange(const io_uring_exchange&) = delete;
+    io_uring_exchange(io_uring_exchange&&) = delete;
+    auto await_ready() const noexcept -> bool;
+    auto await_suspend(std::coroutine_handle<> continuation) -> bool;
+    auto await_resume() -> std::expected<std::size_t, std::error_code>;
+
+private:
+    static void complete_send(uring_overlapped&, int32_t, std::uint32_t);
+    static void complete_read(uring_overlapped&, int32_t, std::uint32_t);
+    void retire();
+    io_uring_context& context_;
+    int fd_;
+    const_buffer output_;
+    mutable_buffer input_;
+    std::size_t sent_{};
+    uring_overlapped send_;
+    uring_overlapped read_;
+    unsigned pending_ = 2;
+    std::coroutine_handle<> continuation_;
+    std::error_code error_;
+};
+
 } // namespace cnetmod
