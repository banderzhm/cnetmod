+io_uring_exchange::io_uring_exchange(io_uring_context& context, socket& stream,
+    const_buffer output, mutable_buffer input) noexcept
+    : context_(context), fd_(static_cast<int>(stream.native_handle())),
+      output_(output), input_(input)
+{
+    send_.completion = &complete_send;
+    read_.completion = &complete_read;
+    send_.completion_context = read_.completion_context = this;
+}
+
+auto io_uring_exchange::await_ready() const noexcept -> bool { return false; }
+
+auto io_uring_exchange::await_suspend(std::coroutine_handle<> continuation) -> bool
+{
+    if (output_.size == 0 || input_.size == 0 ||
+        output_.size > static_cast<std::size_t>(std::numeric_limits<int>::max()) ||
+        input_.size > static_cast<std::size_t>(std::numeric_limits<int>::max()))
+    {
+        error_ = std::make_error_code(std::errc::invalid_argument);
+        return false;
+    }
+    if (::io_uring_sq_space_left(context_.native_ring()) < 2)
+        (void)context_.flush_pending();
+    if (::io_uring_sq_space_left(context_.native_ring()) < 2)
+    {
+        error_ = std::make_error_code(std::errc::no_buffer_space);
+        return false;
+    }
+    auto* send = context_.prepare_sqe();
+    auto* read = context_.prepare_sqe();
+    continuation_ = continuation;
+    ::io_uring_prep_send(send, fd_, output_.data, output_.size, MSG_NOSIGNAL);
+    ::io_uring_sqe_set_data(send, &send_);
+    ::io_uring_prep_recv(read, fd_, input_.data, input_.size, 0);
+    ::io_uring_sqe_set_data(read, &read_);
+    // Once published, both completions must join before releasing the buffers.
+    (void)context_.flush();
+    return true;
+}
+
+void io_uring_exchange::retire()
+{
+    if (--pending_ == 0)
+    {
+        const auto continuation = continuation_;
+        continuation.resume();
+    }
+}
+
+void io_uring_exchange::complete_read(uring_overlapped& operation, int32_t result, std::uint32_t)
+{
+    operation.result = result;
+    static_cast<io_uring_exchange*>(operation.completion_context)->retire();
+}
+
+void io_uring_exchange::complete_send(uring_overlapped& operation, int32_t result, std::uint32_t)
+{
+    auto* state = static_cast<io_uring_exchange*>(operation.completion_context);
+    if (result > 0)
+    {
+        state->sent_ += static_cast<std::size_t>(result);
+        if (state->sent_ < state->output_.size)
+        {
+            auto* next = state->context_.prepare_sqe();
+            if (!next)
+            {
+                (void)state->context_.flush_pending();
+                next = state->context_.prepare_sqe();
+            }
+            if (next)
+            {
+                ::io_uring_prep_send(next, state->fd_,
+                    static_cast<const std::byte*>(state->output_.data) + state->sent_,
+                    state->output_.size - state->sent_, MSG_NOSIGNAL);
+                ::io_uring_sqe_set_data(next, &operation);
+                (void)state->context_.flush();
+                return;
+            }
+            result = -ENOBUFS;
+        }
+    }
+    else if (result == 0)
+        result = -EIO;
+    operation.result = result;
+    if (result < 0)
+        (void)::shutdown(state->fd_, SHUT_RD);
+    state->retire();
+}
+
+auto io_uring_exchange::await_resume() -> std::expected<std::size_t, std::error_code>
+{
+    if (error_)
+        return std::unexpected(error_);
+    if (send_.result < 0)
+        return std::unexpected(std::error_code{-send_.result, std::generic_category()});
+    if (read_.result < 0)
+        return std::unexpected(std::error_code{-read_.result, std::generic_category()});
+    if (read_.result == 0)
+        return std::unexpected(make_error_code(errc::end_of_file));
+    return static_cast<std::size_t>(read_.result);
+}
+
 } // namespace cnetmod
