+TEST(quic_recovery_pmtu_probe_pto_cleanup_preserves_window)
+{
+    for (const auto algorithm : {cnetmod::quic::quic_congestion_algorithm::new_reno,
+             cnetmod::quic::quic_congestion_algorithm::cubic,
