{
  "schemaVersion": 1,
  "name": "cnetmod-sdk",
  "version": "@PROJECT_VERSION@",
  "target": "@CNETMOD_DISTRIBUTION_TARGET_ID@",
  "abi": "@CNETMOD_PACKAGE_ABI@",
  "system": "@CMAKE_SYSTEM_NAME@",
  "architecture": "@CMAKE_SYSTEM_PROCESSOR@",
  "compiler": {
    "id": "@CMAKE_CXX_COMPILER_ID@",
    "version": "@CMAKE_CXX_COMPILER_VERSION@"
  },
  "standardLibrary": "@CNETMOD_PACKAGE_STDLIB@",
  "runtime": "@CNETMOD_PACKAGE_RUNTIME@",
  "platformBaseline": "@CNETMOD_DISTRIBUTION_PLATFORM_BASELINE@",
  "buildType": "@CNETMOD_DISTRIBUTION_CONFIGURATION@",
  "linkage": "static",
  "dependencyMode": "@CNETMOD_DEPENDENCY_MODE@",
  "components": [@CNETMOD_PACKAGE_COMPONENTS_JSON@]
}
