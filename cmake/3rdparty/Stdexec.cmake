include_guard(GLOBAL)
include(${CMAKE_CURRENT_LIST_DIR}/DependencyHelpers.cmake)

macro(cnetmod_configure_stdexec)
    set(CNETMOD_STDEXEC_INCLUDE_DIR "" CACHE PATH "stdexec include directory")
    if(CNETMOD_USE_SYSTEM_DEPS)
        find_package(P2300 CONFIG QUIET)
    endif()
    foreach(_target STDEXEC::stdexec P2300::P2300)
        if(NOT CNETMOD_STDEXEC_INCLUDE_DIR)
            cnetmod_dependency_target_include(_stdexec_from_target "${_target}" exec/static_thread_pool.hpp)
            if(_stdexec_from_target)
                set(CNETMOD_STDEXEC_INCLUDE_DIR "${_stdexec_from_target}" CACHE PATH "" FORCE)
            endif()
        endif()
    endforeach()
    if(NOT CNETMOD_STDEXEC_INCLUDE_DIR AND CNETMOD_USE_SYSTEM_DEPS)
        find_path(CNETMOD_STDEXEC_INCLUDE_DIR NAMES exec/static_thread_pool.hpp stdexec/execution.hpp)
    endif()
    if(NOT CNETMOD_STDEXEC_INCLUDE_DIR AND
       EXISTS "${PROJECT_SOURCE_DIR}/3rdparty/stdexec/include/exec/static_thread_pool.hpp")
        set(CNETMOD_STDEXEC_INCLUDE_DIR "${PROJECT_SOURCE_DIR}/3rdparty/stdexec/include" CACHE PATH "" FORCE)
    endif()
    if(NOT EXISTS "${CNETMOD_STDEXEC_INCLUDE_DIR}/exec/static_thread_pool.hpp")
        message(FATAL_ERROR "stdexec was not found; set CNETMOD_STDEXEC_INCLUDE_DIR or initialize 3rdparty/stdexec")
    endif()
    set(CNETMOD_STDEXEC_EFFECTIVE_INCLUDE_DIR "${CNETMOD_STDEXEC_INCLUDE_DIR}" CACHE INTERNAL "" FORCE)
endmacro()

function(cnetmod_link_stdexec TARGET_NAME)
    target_include_directories(${TARGET_NAME} SYSTEM PRIVATE "${CNETMOD_STDEXEC_EFFECTIVE_INCLUDE_DIR}")
endfunction()
