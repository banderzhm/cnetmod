include_guard(GLOBAL)
include(${CMAKE_CURRENT_LIST_DIR}/DependencyHelpers.cmake)

function(cnetmod_nlohmann_json_version OUT_VAR INCLUDE_DIR)
    set(_header "${INCLUDE_DIR}/nlohmann/detail/abi_macros.hpp")
    if(NOT EXISTS "${_header}")
        set(${OUT_VAR} "" PARENT_SCOPE)
        return()
    endif()
    file(STRINGS "${_header}" _lines REGEX "^#define NLOHMANN_JSON_VERSION_(MAJOR|MINOR|PATCH) [0-9]+")
    foreach(_part MAJOR MINOR PATCH)
        string(REGEX MATCH "#define NLOHMANN_JSON_VERSION_${_part} ([0-9]+)" _match "${_lines}")
        set(_${_part} "${CMAKE_MATCH_1}")
    endforeach()
    if(_MAJOR STREQUAL "" OR _MINOR STREQUAL "" OR _PATCH STREQUAL "")
        set(${OUT_VAR} "" PARENT_SCOPE)
    else()
        set(${OUT_VAR} "${_MAJOR}.${_MINOR}.${_PATCH}" PARENT_SCOPE)
    endif()
endfunction()

macro(cnetmod_configure_nlohmann_json)
    set(CNETMOD_JSON_INCLUDE_DIR "" CACHE PATH "nlohmann/json include directory")
    set(CNETMOD_JSON_MODULE "" CACHE FILEPATH "nlohmann/json C++ module interface")
    set(CNETMOD_JSON_PROVIDER AUTO CACHE STRING "nlohmann/json provider: AUTO, PACKAGE, VENDORED")
    set_property(CACHE CNETMOD_JSON_PROVIDER PROPERTY STRINGS AUTO PACKAGE VENDORED)
    set(CNETMOD_JSON_MINIMUM_VERSION 3.12.0 CACHE STRING "Minimum nlohmann/json version")
    string(TOUPPER "${CNETMOD_JSON_PROVIDER}" CNETMOD_JSON_PROVIDER)
    if(NOT CNETMOD_JSON_PROVIDER MATCHES "^(AUTO|PACKAGE|VENDORED)$")
        message(FATAL_ERROR "CNETMOD_JSON_PROVIDER must be AUTO, PACKAGE, or VENDORED")
    endif()
    set(CNETMOD_JSON_EFFECTIVE_INCLUDE_DIR "")
    set(CNETMOD_JSON_EFFECTIVE_MODULE "")
    set(CNETMOD_JSON_EFFECTIVE_PROVIDER "")
    if(NOT CNETMOD_JSON_PROVIDER STREQUAL VENDORED AND CNETMOD_USE_SYSTEM_DEPS)
        find_package(nlohmann_json ${CNETMOD_JSON_MINIMUM_VERSION} CONFIG QUIET)
        if(NOT CNETMOD_JSON_INCLUDE_DIR)
            cnetmod_dependency_target_include(CNETMOD_JSON_INCLUDE_DIR nlohmann_json::nlohmann_json nlohmann/json.hpp)
        endif()
        if(CNETMOD_JSON_INCLUDE_DIR)
            cnetmod_nlohmann_json_version(_json_version "${CNETMOD_JSON_INCLUDE_DIR}")
            if(_json_version AND NOT _json_version VERSION_LESS CNETMOD_JSON_MINIMUM_VERSION)
                set(CNETMOD_JSON_EFFECTIVE_INCLUDE_DIR "${CNETMOD_JSON_INCLUDE_DIR}")
                set(CNETMOD_JSON_EFFECTIVE_MODULE "${CNETMOD_JSON_MODULE}")
                if(NOT CNETMOD_JSON_EFFECTIVE_MODULE)
                    set(CNETMOD_JSON_EFFECTIVE_MODULE "${PROJECT_SOURCE_DIR}/cmake/modules/nlohmann_json.cppm")
                endif()
                set(CNETMOD_JSON_EFFECTIVE_PROVIDER PACKAGE)
            endif()
        endif()
    endif()
    if(NOT CNETMOD_JSON_EFFECTIVE_INCLUDE_DIR)
        if(CNETMOD_JSON_PROVIDER STREQUAL PACKAGE)
            message(FATAL_ERROR "CNETMOD_JSON_PROVIDER=PACKAGE requires nlohmann/json ${CNETMOD_JSON_MINIMUM_VERSION}+")
        endif()
        set(CNETMOD_JSON_EFFECTIVE_INCLUDE_DIR "${PROJECT_SOURCE_DIR}/3rdparty/json/include")
        set(CNETMOD_JSON_EFFECTIVE_MODULE "${PROJECT_SOURCE_DIR}/3rdparty/json/src/modules/json.cppm")
        set(CNETMOD_JSON_EFFECTIVE_PROVIDER VENDORED)
    endif()
    if(NOT EXISTS "${CNETMOD_JSON_EFFECTIVE_INCLUDE_DIR}/nlohmann/json.hpp" OR
       NOT EXISTS "${CNETMOD_JSON_EFFECTIVE_MODULE}")
        message(FATAL_ERROR "The selected nlohmann/json headers or module interface are missing")
    endif()
    set(NLOHMANN_JSON_MODULE "${CNETMOD_JSON_EFFECTIVE_MODULE}")
endmacro()

function(cnetmod_link_nlohmann_json TARGET_NAME)
    target_include_directories(${TARGET_NAME} BEFORE PRIVATE "${CNETMOD_JSON_EFFECTIVE_INCLUDE_DIR}")
    if(CNETMOD_JSON_EFFECTIVE_PROVIDER STREQUAL PACKAGE AND TARGET nlohmann_json::nlohmann_json)
        target_link_libraries(${TARGET_NAME} PUBLIC nlohmann_json::nlohmann_json)
    endif()
endfunction()
