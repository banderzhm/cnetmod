include_guard(GLOBAL)

macro(cnetmod_configure_zlib)
    set(CNETMOD_ZLIB_ROOT "" CACHE PATH "Optional zlib installation prefix")
    set(CNETMOD_HAS_ZLIB OFF)
    if(CNETMOD_ENABLE_HTTP OR CNETMOD_ENABLE_GRPC OR CNETMOD_ENABLE_KAFKA OR CNETMOD_ENABLE_MONGODB)
        if(CNETMOD_ZLIB_ROOT)
            set(ZLIB_ROOT "${CNETMOD_ZLIB_ROOT}")
        endif()
        find_package(ZLIB QUIET)
        if(NOT ZLIB_FOUND)
            find_path(CNETMOD_ZLIB_INCLUDE_DIR zlib.h HINTS "${CNETMOD_ZLIB_ROOT}" "$ENV{CONDA_PREFIX}" PATH_SUFFIXES include Library/include)
            find_library(CNETMOD_ZLIB_LIBRARY NAMES zlib zlibstatic zlib-ng HINTS "${CNETMOD_ZLIB_ROOT}" "$ENV{CONDA_PREFIX}" PATH_SUFFIXES lib Library/lib)
            if(CNETMOD_ZLIB_INCLUDE_DIR AND CNETMOD_ZLIB_LIBRARY)
                add_library(ZLIB::ZLIB UNKNOWN IMPORTED)
                set_target_properties(ZLIB::ZLIB PROPERTIES IMPORTED_LOCATION "${CNETMOD_ZLIB_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${CNETMOD_ZLIB_INCLUDE_DIR}")
                set(ZLIB_FOUND ON)
            endif()
        endif()
        if(ZLIB_FOUND)
            set(CNETMOD_HAS_ZLIB ON)
        endif()
    endif()
endmacro()

function(cnetmod_link_zlib TARGET_NAME)
    if(CNETMOD_HAS_ZLIB)
        target_link_libraries(${TARGET_NAME} PUBLIC ZLIB::ZLIB)
    endif()
endfunction()
