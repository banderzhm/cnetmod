include_guard(GLOBAL)

macro(cnetmod_configure_pugixml)
    set(CNETMOD_HAS_PUGIXML OFF)
    set(CNETMOD_PUGIXML_TARGET "")
    if(CNETMOD_ENABLE_ORM)
        if(CNETMOD_USE_SYSTEM_DEPS)
            find_package(pugixml CONFIG QUIET)
        endif()
        foreach(_target pugixml::pugixml pugixml-static pugixml)
            if(TARGET "${_target}" AND NOT CNETMOD_PUGIXML_TARGET)
                set(CNETMOD_PUGIXML_TARGET "${_target}")
            endif()
        endforeach()
        if(NOT CNETMOD_PUGIXML_TARGET AND EXISTS "${PROJECT_SOURCE_DIR}/3rdparty/pugixml/CMakeLists.txt")
            set(_saved_build_shared_libs "${BUILD_SHARED_LIBS}")
            set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
            add_subdirectory("${PROJECT_SOURCE_DIR}/3rdparty/pugixml" "${PROJECT_BINARY_DIR}/3rdparty/pugixml" EXCLUDE_FROM_ALL)
            set(BUILD_SHARED_LIBS "${_saved_build_shared_libs}" CACHE BOOL "" FORCE)
            set(CNETMOD_PUGIXML_TARGET pugixml-static)
        endif()
        if(NOT CNETMOD_PUGIXML_TARGET)
            message(FATAL_ERROR "CNETMOD_ENABLE_ORM=ON requires pugixml")
        endif()
        set(CNETMOD_HAS_PUGIXML ON)
    endif()
endmacro()

function(cnetmod_link_pugixml TARGET_NAME)
    if(CNETMOD_HAS_PUGIXML)
        target_link_libraries(${TARGET_NAME} PUBLIC ${CNETMOD_PUGIXML_TARGET})
    endif()
endfunction()
