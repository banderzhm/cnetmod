include_guard(GLOBAL)

macro(cnetmod_configure_leveldb)
    option(CNETMOD_ENABLE_LEVELDB "Enable LevelDB-backed Raft storage" ON)
    set(CNETMOD_HAS_LEVELDB OFF)
    set(CNETMOD_LEVELDB_TARGET "")
    if(CNETMOD_ENABLE_RAFT AND CNETMOD_ENABLE_LEVELDB)
        if(CNETMOD_USE_SYSTEM_DEPS)
            find_package(leveldb CONFIG QUIET)
            find_package(LevelDB QUIET)
        endif()
        foreach(_target leveldb leveldb::leveldb LevelDB::LevelDB)
            if(TARGET "${_target}" AND NOT CNETMOD_LEVELDB_TARGET)
                set(CNETMOD_LEVELDB_TARGET "${_target}")
            endif()
        endforeach()
        if(NOT CNETMOD_LEVELDB_TARGET AND EXISTS "${PROJECT_SOURCE_DIR}/3rdparty/leveldb/CMakeLists.txt")
            set(LEVELDB_BUILD_TESTS OFF CACHE BOOL "" FORCE)
            set(LEVELDB_BUILD_BENCHMARKS OFF CACHE BOOL "" FORCE)
            set(LEVELDB_INSTALL OFF CACHE BOOL "" FORCE)
            add_subdirectory("${PROJECT_SOURCE_DIR}/3rdparty/leveldb" "${PROJECT_BINARY_DIR}/3rdparty/leveldb" EXCLUDE_FROM_ALL)
            set(CNETMOD_LEVELDB_TARGET leveldb)
            foreach(_property COMPILE_OPTIONS INTERFACE_COMPILE_OPTIONS)
                get_target_property(_options leveldb ${_property})
                if(_options)
                    list(REMOVE_ITEM _options -Werror)
                    set_target_properties(leveldb PROPERTIES ${_property} "${_options}")
                endif()
            endforeach()
        endif()
        if(CNETMOD_LEVELDB_TARGET)
            set(CNETMOD_HAS_LEVELDB ON)
        else()
            find_path(CNETMOD_LEVELDB_INCLUDE_DIR leveldb/db.h)
            find_library(CNETMOD_LEVELDB_LIBRARY leveldb)
            if(CNETMOD_LEVELDB_INCLUDE_DIR AND CNETMOD_LEVELDB_LIBRARY)
                set(CNETMOD_HAS_LEVELDB ON)
            endif()
        endif()
    endif()
endmacro()

function(cnetmod_link_leveldb TARGET_NAME)
    if(CNETMOD_HAS_LEVELDB)
        if(CNETMOD_LEVELDB_TARGET)
            target_link_libraries(${TARGET_NAME} PUBLIC ${CNETMOD_LEVELDB_TARGET})
        else()
            target_include_directories(${TARGET_NAME} PRIVATE "${CNETMOD_LEVELDB_INCLUDE_DIR}")
            target_link_libraries(${TARGET_NAME} PUBLIC "${CNETMOD_LEVELDB_LIBRARY}")
        endif()
    endif()
endfunction()
