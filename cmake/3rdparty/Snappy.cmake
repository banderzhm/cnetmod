include_guard(GLOBAL)

macro(cnetmod_configure_snappy)
    option(CNETMOD_ENABLE_MONGODB_SNAPPY "Build MongoDB Snappy wire compression" ON)
    set(CNETMOD_HAS_SNAPPY OFF)
    if(CNETMOD_ENABLE_MONGODB AND CNETMOD_ENABLE_MONGODB_SNAPPY)
        find_package(Snappy CONFIG QUIET)
        find_package(snappy CONFIG QUIET)
        foreach(_target Snappy::snappy snappy::snappy snappy)
            if(TARGET ${_target})
                set(CNETMOD_SNAPPY_TARGET ${_target})
                break()
            endif()
        endforeach()
        if(NOT CNETMOD_SNAPPY_TARGET)
            find_path(CNETMOD_SNAPPY_INCLUDE_DIR snappy-c.h)
            find_library(CNETMOD_SNAPPY_LIBRARY NAMES snappy)
            if(CNETMOD_SNAPPY_INCLUDE_DIR AND CNETMOD_SNAPPY_LIBRARY)
                add_library(cnetmod_snappy UNKNOWN IMPORTED)
                set_target_properties(cnetmod_snappy PROPERTIES
                    IMPORTED_LOCATION "${CNETMOD_SNAPPY_LIBRARY}"
                    INTERFACE_INCLUDE_DIRECTORIES "${CNETMOD_SNAPPY_INCLUDE_DIR}")
                set(CNETMOD_SNAPPY_TARGET cnetmod_snappy)
            endif()
        endif()
        if(NOT CNETMOD_SNAPPY_TARGET)
            message(STATUS
                "MongoDB Snappy requested but libsnappy is unavailable; "
                "building MongoDB without Snappy wire compression")
        else()
            set(CNETMOD_HAS_SNAPPY ON)
        endif()
    endif()
endmacro()

function(cnetmod_link_snappy TARGET_NAME)
    if(CNETMOD_HAS_SNAPPY)
        target_link_libraries(${TARGET_NAME} PUBLIC ${CNETMOD_SNAPPY_TARGET})
    endif()
endfunction()
