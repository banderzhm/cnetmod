include_guard(GLOBAL)

macro(cnetmod_configure_lz4)
    option(CNETMOD_ENABLE_LZ4 "Enable Kafka LZ4 compression" ON)
    set(CNETMOD_LZ4_ROOT "" CACHE PATH "Optional LZ4 installation prefix")
    set(CNETMOD_HAS_LZ4 OFF)
    set(CNETMOD_LZ4_TARGET "")
    if(CNETMOD_ENABLE_KAFKA AND CNETMOD_ENABLE_LZ4)
        find_package(lz4 CONFIG QUIET)
        find_package(LZ4 CONFIG QUIET)
        foreach(_target lz4::lz4 LZ4::lz4 LZ4::LZ4 unofficial::lz4::lz4 lz4_static lz4_shared)
            if(TARGET "${_target}" AND NOT CNETMOD_LZ4_TARGET)
                set(CNETMOD_LZ4_TARGET "${_target}")
            endif()
        endforeach()
        if(NOT CNETMOD_LZ4_TARGET)
            find_path(CNETMOD_LZ4_INCLUDE_DIR lz4frame.h HINTS "${CNETMOD_LZ4_ROOT}" "$ENV{CONDA_PREFIX}" PATH_SUFFIXES include Library/include)
            find_library(CNETMOD_LZ4_LIBRARY NAMES lz4 liblz4 HINTS "${CNETMOD_LZ4_ROOT}" "$ENV{CONDA_PREFIX}" PATH_SUFFIXES lib Library/lib)
        endif()
        if(CNETMOD_LZ4_TARGET OR (CNETMOD_LZ4_INCLUDE_DIR AND CNETMOD_LZ4_LIBRARY))
            set(CNETMOD_HAS_LZ4 ON)
        endif()
    endif()
endmacro()

function(cnetmod_link_lz4 TARGET_NAME)
    if(CNETMOD_HAS_LZ4)
        if(CNETMOD_LZ4_TARGET)
            target_link_libraries(${TARGET_NAME} PUBLIC ${CNETMOD_LZ4_TARGET})
        else()
            target_include_directories(${TARGET_NAME} PRIVATE "${CNETMOD_LZ4_INCLUDE_DIR}")
            target_link_libraries(${TARGET_NAME} PUBLIC "${CNETMOD_LZ4_LIBRARY}")
        endif()
    endif()
endfunction()
