@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@CNETMOD_HAS_YAML_CONFIGURATION@)
    find_dependency(yaml_cpp_modules CONFIG)
endif()

# leveldb is exported as part of the package when enabled.  Its public link
# interface refers to Threads::Threads, so create that imported target before
# loading cnetmodTargets.cmake in every consumer project.
if(@CNETMOD_HAS_LEVELDB@)
    find_dependency(Threads)
endif()

# Resolve exactly the dependencies retained by the configured static target.
if(@CNETMOD_HAS_SSL@)
    if(@BoringSSL_FOUND@)
        if(NOT TARGET OpenSSL::Crypto)
            add_library(OpenSSL::Crypto STATIC IMPORTED)
            set_target_properties(OpenSSL::Crypto PROPERTIES
                IMPORTED_LOCATION
                    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cnetmod/boringssl/${CMAKE_STATIC_LIBRARY_PREFIX}crypto${CMAKE_STATIC_LIBRARY_SUFFIX}"
                INTERFACE_INCLUDE_DIRECTORIES
                    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
        endif()
        if(NOT TARGET OpenSSL::SSL)
            add_library(OpenSSL::SSL STATIC IMPORTED)
            set_target_properties(OpenSSL::SSL PROPERTIES
                IMPORTED_LOCATION
                    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cnetmod/boringssl/${CMAKE_STATIC_LIBRARY_PREFIX}ssl${CMAKE_STATIC_LIBRARY_SUFFIX}"
                INTERFACE_INCLUDE_DIRECTORIES
                    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
                INTERFACE_LINK_LIBRARIES OpenSSL::Crypto)
        endif()
    else()
        find_dependency(OpenSSL)
    endif()
endif()
if(@CNETMOD_HAS_ZLIB@)
    find_dependency(ZLIB)
endif()
if(@CNETMOD_HAS_ZSTD@)
    find_dependency(zstd CONFIG)
endif()
if(@CNETMOD_HAS_BROTLI@)
    set(_cnetmod_brotli_targets "@CNETMOD_BROTLI_TARGETS@")
    if("${_cnetmod_brotli_targets}" MATCHES "cnetmod_brotli")
        find_path(_cnetmod_brotli_include_dir brotli/encode.h)
        find_library(_cnetmod_brotli_encoder NAMES brotlienc)
        find_library(_cnetmod_brotli_decoder NAMES brotlidec)
        if(NOT _cnetmod_brotli_include_dir OR
           NOT _cnetmod_brotli_encoder OR NOT _cnetmod_brotli_decoder)
            set(cnetmod_FOUND FALSE)
            set(cnetmod_NOT_FOUND_MESSAGE
                "cnetmod requires the Brotli encoder and decoder libraries")
            return()
        endif()
        if(NOT TARGET cnetmod_brotlienc)
            add_library(cnetmod_brotlienc UNKNOWN IMPORTED)
            set_target_properties(cnetmod_brotlienc PROPERTIES
                IMPORTED_LOCATION "${_cnetmod_brotli_encoder}"
                INTERFACE_INCLUDE_DIRECTORIES "${_cnetmod_brotli_include_dir}")
        endif()
        if(NOT TARGET cnetmod_brotlidec)
            add_library(cnetmod_brotlidec UNKNOWN IMPORTED)
            set_target_properties(cnetmod_brotlidec PROPERTIES
                IMPORTED_LOCATION "${_cnetmod_brotli_decoder}"
                INTERFACE_INCLUDE_DIRECTORIES "${_cnetmod_brotli_include_dir}")
        endif()
    else()
        find_dependency(unofficial-brotli CONFIG)
    endif()
endif()
if(@CNETMOD_HAS_ICU@)
    find_dependency(ICU COMPONENTS uc i18n)
endif()
if(@CNETMOD_HAS_PUGIXML@)
    if("@CNETMOD_PUGIXML_TARGET@" STREQUAL "pugixml-static")
        # The bundled static archive is installed with cnetmod, but it is not
        # part of cnetmodTargets. Recreate the link target for consumers.
        if(NOT TARGET pugixml::static)
            add_library(pugixml::static STATIC IMPORTED)
            set_target_properties(pugixml::static PROPERTIES
                IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/${CMAKE_STATIC_LIBRARY_PREFIX}pugixml${CMAKE_STATIC_LIBRARY_SUFFIX}"
                INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
        endif()
    else()
        find_dependency(pugixml CONFIG)
    endif()
endif()

if(@CNETMOD_HAS_LZ4@)
    find_package(lz4 CONFIG QUIET)
    if(NOT TARGET lz4::lz4 AND NOT TARGET LZ4::lz4 AND
       NOT TARGET LZ4::LZ4 AND NOT TARGET unofficial::lz4::lz4 AND
       NOT TARGET lz4_static AND NOT TARGET lz4_shared)
        find_package(LZ4 CONFIG QUIET)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cnetmodTargets.cmake")

# libc++ owns the std/std.compat module fragments.  The installed std.cppm
# interfaces keep those relative includes and therefore consume them directly
# from the matching local Clang installation.
if(UNIX)
    get_filename_component(_cnetmod_compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
    get_filename_component(_cnetmod_compiler_prefix "${_cnetmod_compiler_bin}" DIRECTORY)
    find_path(_cnetmod_libcxx_module_dir
        NAMES std/algorithm.inc std.compat/cassert.inc
        PATHS
            "${_cnetmod_compiler_prefix}/share/libc++/v1"
            "@LIBCXX_MODULE_DIRS@"
            /usr/lib/llvm-22/share/libc++/v1
            /usr/local/lib/llvm-22/share/libc++/v1
            /opt/homebrew/opt/llvm@22/share/libc++/v1
            /opt/homebrew/opt/llvm@21/share/libc++/v1
            /opt/homebrew/opt/llvm@20/share/libc++/v1
            /usr/local/opt/llvm@22/share/libc++/v1
            /usr/local/opt/llvm@21/share/libc++/v1
            /usr/local/opt/llvm@20/share/libc++/v1
            /opt/llvm/share/libc++/v1
            /usr/share/libc++/v1
    )
    if(NOT _cnetmod_libcxx_module_dir)
        message(FATAL_ERROR
            "cnetmod requires the libc++ module directory matching the consumer compiler")
    endif()
    set_property(TARGET cnetmod::cnetmod_core APPEND PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES "${_cnetmod_libcxx_module_dir}")
    set_property(TARGET cnetmod::cnetmod_core APPEND PROPERTY
        INTERFACE_COMPILE_OPTIONS "-stdlib=libc++;-nostdinc++")
    set_property(TARGET cnetmod::cnetmod_core APPEND PROPERTY
        INTERFACE_LINK_OPTIONS "-stdlib=libc++")
endif()

# MSBuild supplies `import std` itself, but Ninja has no equivalent implicit
# provider.  Add the MSVC STL module units to the imported module graph when a
# consumer uses Ninja.  This keeps the release archive binary-only while still
# allowing downstream `.cppm` units to import `std`.
if(MSVC AND CMAKE_GENERATOR MATCHES "Ninja")
    get_filename_component(_cnetmod_compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
    get_filename_component(_cnetmod_compiler_host "${_cnetmod_compiler_bin}" DIRECTORY)
    get_filename_component(_cnetmod_compiler_bin_root "${_cnetmod_compiler_host}" DIRECTORY)
    get_filename_component(_cnetmod_msvc_root "${_cnetmod_compiler_bin_root}" DIRECTORY)
    set(_cnetmod_msvc_modules "${_cnetmod_msvc_root}/modules")

    if(EXISTS "${_cnetmod_msvc_modules}/std.ixx" AND
       EXISTS "${_cnetmod_msvc_modules}/std.compat.ixx")
        target_sources(cnetmod::cnetmod_core INTERFACE
            FILE_SET cxx_std_modules TYPE CXX_MODULES
            BASE_DIRS "${_cnetmod_msvc_modules}"
            FILES
                "${_cnetmod_msvc_modules}/std.ixx"
                "${_cnetmod_msvc_modules}/std.compat.ixx")
    else()
        message(FATAL_ERROR
            "cnetmod requires MSVC STL module units for Ninja consumers. "
            "Set up a complete MSVC toolchain that provides std.ixx.")
    endif()
endif()

check_required_components(cnetmod)
